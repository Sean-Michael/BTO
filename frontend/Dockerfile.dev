# syntax=docker/dockerfile:1
# Development image: deps baked in, source mounted at runtime for HMR.
FROM node:22-slim
WORKDIR /app

# Patch base-image OS packages (clears fixable CVEs the scan flags in node:22-slim).
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
# npm is only needed to install. It vendors its own copies of undici and
# brace-expansion that lag behind security fixes, so remove it afterwards and
# run Vite with node directly.
RUN npm ci \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

EXPOSE 5173
CMD ["node", "node_modules/vite/bin/vite.js", "--host"]
